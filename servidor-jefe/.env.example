# Copia este archivo como .env y completa la clave. NUNCA subas .env a un repositorio.
ANTHROPIC_API_KEY=pega-aqui-tu-clave

# Opcionales (valores por defecto entre paréntesis)
# PORT=3000
# JEFE_MODELO=claude-opus-5-5       # alternativa más económica: claude-sonnet-5-5 o claude-haiku-4-5
# JEFE_ESFUERZO=low                 # low | medium | high
# JEFE_MAX_TOKENS=1500
# JEFE_FALLBACK=1                   # 0 para desactivar el re-intento automático ante rechazos de seguridad
# JEFE_LIMITE_MIN=20                # peticiones por minuto y por IP
# JEFE_LIMITE_DIA=300               # peticiones por día y por IP
# JEFE_ORIGEN=https://tu-dominio.com   # solo si la página y este servidor están en dominios distintos
# JEFE_PROXY=1                      # si estás detrás de un proxy/balanceador (usa X-Forwarded-For)
# JEFE_WEB=../src                   # carpeta con el juego
# JEFE_API_URL=http://localhost:8199  # SOLO para probar con el simulador (npm run dev:simulador); en producción déjala sin definir
